<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:AriaUI.ViewModels"
             xmlns:conv="using:AriaUI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="750"
             x:Class="AriaUI.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <ScrollViewer Margin="28,20,28,24" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="760" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="4">
                <TextBlock Text="设置中心" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="配置 Aria2 引擎、RPC 连接、下载偏好及 BT Tracker 订阅"
                           FontSize="13"
                           Foreground="{DynamicResource SemiColorText2}"/>
            </StackPanel>

            <!-- Status Alert if any -->
            <Border Background="{Binding IsStatusError, Converter={x:Static conv:StatusAlertBackgroundConverter.Instance}}"
                    BorderBrush="{Binding IsStatusError, Converter={x:Static conv:StatusAlertBorderBrushConverter.Instance}}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12,8"
                    IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{Binding IsStatusError, Converter={x:Static conv:StatusAlertForegroundConverter.Instance}}"
                           FontWeight="SemiBold"/>
            </Border>

            <!-- Section 0: Appearance & Theme -->
            <Border Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="界面与主题偏好" FontSize="16" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="外观主题:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding AvailableThemes}"
                                  SelectedItem="{Binding ThemeMode, Mode=TwoWay}"
                                  HorizontalAlignment="Left"
                                  Width="180"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 1: Aria2 Daemon & RPC -->
            <Border Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Aria2 核心与 RPC 服务" FontSize="16" FontWeight="SemiBold"/>

                    <CheckBox IsChecked="{Binding AutoStartDaemon}"
                              Content="自动管理并启动本地 aria2c 守护进程"/>

                    <CheckBox IsChecked="{Binding AllowInvalidCert}"
                              Content="aria2 下载允许无效 TLS 证书 (--check-certificate=false)"/>

                    <CheckBox IsChecked="{Binding RpcUseTls}"
                              Content="外部 RPC 使用 TLS (wss/https；需关闭本地 daemon 自动管理)"/>

                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                        <!-- Custom Executable Path -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="aria2c 路径:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding Aria2ExecutablePath, Mode=TwoWay}"
                                 PlaceholderText="留空则自动检测 (~/.local/bin 或系统 PATH)"
                                 Margin="0,0,0,10"/>

                        <!-- RPC Host -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="RPC 地址:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1"
                                 Text="{Binding RpcHost, Mode=TwoWay}"
                                 Margin="0,0,0,10"/>

                        <!-- RPC Port -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="RPC 端口:" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding RpcPort}"
                                       FormatString="0"
                                       Minimum="1"
                                       Maximum="65535"
                                       Margin="0,0,0,10"/>

                        <!-- RPC Secret -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="RPC 密钥 (Secret):" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="1"
                                 Text="{Binding RpcSecret, Mode=TwoWay}"
                                 PasswordChar="•"
                                 PlaceholderText="RPC Token 鉴权密钥"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 2: Download Rules & Limits -->
            <Border Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="下载偏好与网络规则" FontSize="16" FontWeight="SemiBold"/>

                    <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" Margin="0,4,0,0">
                        <!-- Default Download Dir -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="默认下载目录:" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="1"
                                 Text="{Binding DefaultDownloadDir, Mode=TwoWay}"
                                 Margin="0,0,0,10"/>

                        <!-- Max Concurrent Downloads -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="最大并行任务数:" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="1" Grid.Column="1"
                                       Value="{Binding MaxConcurrentDownloads}"
                                       FormatString="0"
                                       Minimum="1"
                                       Maximum="64"
                                       Margin="0,0,0,10"/>

                        <!-- Split Connections -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="单任务最大连接数:" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="1"
                                       Value="{Binding MaxConnectionPerServer}"
                                       FormatString="0"
                                       Minimum="1"
                                       Maximum="64"
                                       Margin="0,0,0,10"/>

                        <!-- Global Download Limit -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="全局下载限速 (KB/s):" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="3" Grid.Column="1"
                                       Value="{Binding DownloadLimitKB}"
                                       FormatString="0"
                                       Minimum="0"
                                       Margin="0,0,0,10"/>

                        <!-- Global Upload Limit -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="全局上传限速 (KB/s):" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Row="4" Grid.Column="1"
                                       Value="{Binding UploadLimitKB}"
                                       FormatString="0"
                                       Minimum="0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Section 3: BT Trackers -->
            <Border Background="{DynamicResource SemiColorBackground1}"
                    BorderBrush="{DynamicResource SemiColorBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="BT Tracker 订阅加速" FontSize="16" FontWeight="SemiBold"/>
                        <Button Grid.Column="1"
                                Classes="Secondary"
                                Command="{Binding UpdateTrackersCommand}"
                                IsEnabled="{Binding !IsUpdatingTrackers}"
                                Padding="12,4">
                            <TextBlock Text="🔄 在线更新 Tracker" FontSize="12"/>
                        </Button>
                    </Grid>

                    <CheckBox IsChecked="{Binding EnableBtTrackers}"
                              Content="自动将 Tracker 节点注入到 BitTorrent 任务中以加速下载"/>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Tracker 订阅源 URL:" FontSize="13"/>
                        <TextBox Text="{Binding CustomTrackersUrl, Mode=TwoWay}"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="当前 Tracker 节点列表 (每行一条):" FontSize="13"/>
                        <TextBox Text="{Binding ExtraTrackers, Mode=TwoWay}"
                                 AcceptsReturn="True"
                                 Height="90"
                                 TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Save Action Button -->
            <Button Classes="Primary"
                    Command="{Binding SaveCommand}"
                    Padding="24,10"
                    HorizontalAlignment="Left">
                <TextBlock Text="保存并应用配置" FontWeight="SemiBold" FontSize="14"/>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
