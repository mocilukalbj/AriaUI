{
  "manifest_version": 3,
  "name": "AriaUI Companion",
  "short_name": "AriaUI",
  "version": "0.1.6",
  "description": "AriaUI 浏览器伴侣：通过 Native Messaging 交接下载。",
  "minimum_chrome_version": "116",
  "permissions": ["downloads", "storage", "nativeMessaging", "contextMenus", "notifications", "webRequest", "alarms", "cookies"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "incognito": "not_allowed",
  "options_page": "options.html",
  "action": { "default_title": "AriaUI：设置与交接记录", "default_icon": "images/logo32.png" },
  "icons": { "16": "images/logo16.png", "32": "images/logo32.png", "48": "images/logo48.png", "128": "images/logo128.png" },
  "commands": {
    "toggle-capture": { "suggested_key": { "default": "Alt+A" }, "description": "切换自动接管" }
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'" }
}
